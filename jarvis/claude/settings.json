{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "JARVIS_REPLY_URL": "http://127.0.0.1:8766/reply"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.jarvis/stop_speak.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "TodoWrite",
      "WebSearch",
      "WebFetch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(pytest:*)",
      "mcp__memory",
      "mcp__google",
      "mcp__browser"
    ],
    "ask": [
      "mcp__hands",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/id_rsa)",
      "Read(./**/credentials.json)",
      "Read(./**/token.json)",
      "Bash(curl:*)",
      "Bash(rm -rf:*)",
      "Bash(shutdown:*)"
    ]
  }
}
